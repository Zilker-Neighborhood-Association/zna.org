{#
/**
 * @file
 * Promo Card component (override of civictheme:promo-card).
 *
 * Restores the <h4> heading wrapper and the civictheme:link include in the
 * title (lost in civictheme 1.12). Everything else is identical to upstream.
 *
 * Props:
 * - theme: [string] Theme variation (light or dark).
 * - image: [object] Card image.
 *   Each property contains:
 *   - url: [string] Image URL.
 *   - alt: [string] Image alt text.
 * - is_title_click: [boolean] Whether to make only the title clickable instead of the whole card.
 * - attributes: [Drupal\Core\Template\Attribute] Additional HTML attributes.
 * - modifier_class: [string] Additional CSS classes.
 * - date_iso: [string] Start date and time in ISO format.
 * - date: [string] Start date and time.
 * - date_end_iso: [string] End time in ISO format.
 * - date_end: [string] Formatted end time.
 * - link: [object] Card link object.
 *   Each property contains:
 *   - url: [string] Link URL.
 *   - is_new_window: [boolean] Whether to open the link in a new window.
 *   - is_external: [boolean] Whether the link is external.
 * - tags: [array] Card tags:
 *   Each item contains:
 *   - text: [string] Tag text.
 *   - url: [string] Tag URL.
 *   - is_new_window: [boolean] Whether to open the tag in a new window.
 *
 * Slots:
 * - subtitle: Subtitle text.
 * - title: Card title text.
 * - summary: Card summary.
 * - content_top: Top content area.
 * - image_over: Image overlay content.
 * - content_middle: Middle content area.
 * - content_bottom: Bottom content area.
 *
 * Blocks:
 * - image_block
 * - image_over_block
 * - content_block
 * - content_top_block
 * - subtitle_block
 * - date_block
 * - title_block
 * - content_middle_block
 * - summary_block
 * - content_tags_block
 * - content_bottom_block
 */
#}

{% set with_image = image.url is not empty %}
{% set with_image_class = with_image ? 'ct-promo-card--with-image' : '' %}
{% set with_link = link is not empty and link.url is defined and link.url is not empty %}
{% set is_card_clickable = with_link and is_title_click is empty %}
{% set card_clickable_class = is_card_clickable ? 'ct-promo-card--card-clickable' : '' %}
{% set image_over_class = image_over ? 'ct-promo-card--image-over' : '' %}
{% set theme_class = 'ct-theme-%s'|format(theme|default('light')) %}
{% set modifier_class = '%s %s %s %s %s'|format(theme_class, with_image_class, image_over_class, card_clickable_class, modifier_class|default('')) %}

{% if title is not empty %}
  <div class="ct-promo-card {{ modifier_class -}}" {% if attributes is defined and attributes is not null %}{{- attributes -}}{% endif %}>
    {% block image_block %}
      {% if image.url is not empty or image_over is not empty %}
        <div class="ct-promo-card__image">
          {% include 'civictheme:image' with {
            theme: theme,
            url: image.url,
            alt: image.alt,
          } only %}

          {% block image_over_block %}
            {% if image_over is not empty %}
              <div class="ct-promo-card__image__over">
                {{ image_over }}
              </div>
            {% endif %}
          {% endblock %}
        </div>
      {% endif %}
    {% endblock %}

    {% block content_block %}
      <div class="ct-promo-card__content">
        {% block content_top_block %}
          {% if content_top is not empty %}
            <div class="ct-promo-card__content-top">
              {{- content_top -}}
            </div>
          {% endif %}
        {% endblock %}

        {% block subtitle_block %}
          {% if subtitle is not empty %}
            <div class="ct-promo-card__subtitle">
              {% include 'civictheme:tag' with {
                theme: theme,
                type: 'tertiary',
                content: subtitle,
              } only %}
            </div>
          {% endif %}
        {% endblock %}

        {% block date_block %}
          {% if date is not empty %}
            {% set date_content %}
              {% include 'civictheme:datetime' with {
                start: date,
                start_iso: date_iso|default(null),
                end: date_end|default(null),
                end_iso: date_end_iso|default(null),
              } only %}
            {% endset %}

            <div class="ct-promo-card__date">
              {% include 'civictheme:tag' with {
                theme: theme,
                type: date_end ? 'secondary' : 'tertiary',
                content: date_content,
                icon: date_end ? 'calendar-2' : null,
                icon_placement: 'before',
              } only %}
            </div>
          {% endif %}
        {% endblock %}

        {% block title_block %}
          {% if title is not empty %}
            {% set title_content %}
              {% if with_link %}
                {#
                  Use civictheme:link to restore <a class="ct-link ...">
                  styling, the (Opens in a new tab/window) a11y span, and
                  proper hover/focus states. Pass is_external=false so the
                  external-link SVG icon is not rendered next to the title
                  (matches the 1.10 design). Pass the legacy double-
                  underscore modifier class so the 1.12 promo-card.scss
                  doesn't override the link color with the dark title color.
                #}
                {% include 'civictheme:link' with {
                  theme: theme,
                  text: title,
                  url: link.url,
                  is_new_window: link.is_new_window,
                  is_external: false,
                  modifier_class: 'ct-promo-card__title__link',
                } only %}
              {% else %}
                {{ title }}
              {% endif %}
            {% endset %}
            {% include 'civictheme:heading' with {
              theme: theme,
              content: title_content,
              level: 4,
              modifier_class: 'ct-promo-card__title',
            } only %}
          {% endif %}
        {% endblock %}

        {% block content_middle_block %}
          {% if content_middle is not empty %}
            <div class="ct-promo-card__content-middle">
              {{- content_middle -}}
            </div>
          {% endif %}
        {% endblock %}

        {% block summary_block %}
          {% if summary is not empty %}
            {% include 'civictheme:paragraph' with {
              theme: theme,
              content: summary,
              no_margin: true,
              modifier_class: 'ct-promo-card__summary',
            } only %}
          {% endif %}
        {% endblock %}

        {% block content_tags_block %}
          {#
            The 1.10 promo-card design has no bottom-right chevron arrow on
            promo cards (only the title text + whole-card hit area). Drop the
            `__link-graphic` block; tags still render. Whole-card clickability
            is preserved via the title link `::before` cover-parent rule in
            promo-card.css.
          #}
          {% if tags %}
            <div class="ct-promo-card__tags">
              {% include 'civictheme:tag-list' with {
                theme: theme,
                tags: tags,
              } only %}
            </div>
          {% endif %}
        {% endblock %}

        {% block content_bottom_block %}
          {% if content_bottom is not empty %}
            <div class="ct-promo-card__content-bottom">
              {{- content_bottom -}}
            </div>
          {% endif %}
        {% endblock %}
      </div>
    {% endblock %}
  </div>
{% endif %}
